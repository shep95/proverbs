# =========================================================================
#  proverbs — environment configuration
#  Copy to .env for local dev, or set these as Variables in Railway.
#  The ONLY required value is DISCORD_TOKEN. Everything else has a default.
# =========================================================================

# --- Discord (REQUIRED) ----------------------------------------------------
# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# Optional: restrict slash-command sync to one guild for instant updates while
# developing (global sync can take up to an hour). Leave blank for global.
DISCORD_GUILD_ID=

# Optional: channel ID where scheduled market alerts are posted.
# If blank, scheduled alerts are disabled (commands still work).
DISCORD_ALERT_CHANNEL_ID=

# Command prefix for classic text commands (slash commands also work).
DISCORD_COMMAND_PREFIX=!

# --- Watchlist / engine ----------------------------------------------------
# Comma-separated tickers the engine analyses each cycle.
WATCHLIST=AAPL,MSFT,GOOGL,TSLA

# How often (minutes) the background engine runs a full analysis cycle.
CYCLE_INTERVAL_MINUTES=30

# Orchestrator signal weights (must be sensible; they are re-normalised).
FISCAL_WEIGHT=0.65
CULTURAL_WEIGHT=0.35

# Combined-score thresholds for BUY / REDUCE (HOLD is the band between them).
BUY_THRESHOLD=0.3
REDUCE_THRESHOLD=-0.3

# --- Auto-withdrawal (paper simulation) ------------------------------------
# When simulated balance >= deposit * MULTIPLE, withdraw FRACTION of profit.
AUTO_WITHDRAW_MULTIPLE=5.5
AUTO_WITHDRAW_FRACTION=0.2

# --- Persistence -----------------------------------------------------------
# SQLAlchemy URL. Defaults to a local SQLite file. On Railway, add a Postgres
# plugin and it injects DATABASE_URL automatically (postgresql://...).
DATABASE_URL=sqlite:///proverbs.db

# --- Cultural AI backend ---------------------------------------------------
# vader (default, lightweight) | transformers (needs torch, see requirements.txt)
CULTURAL_BACKEND=vader

# --- News backend ----------------------------------------------------------
# rss (default, keyless) | newsapi (needs NEWSAPI_KEY)
NEWS_BACKEND=rss
NEWSAPI_KEY=

# --- Web dashboard ---------------------------------------------------------
# Railway sets PORT automatically. Locally defaults to 8080.
PORT=8080
# Set to "false" to run the Discord bot only, without the Flask dashboard.
ENABLE_WEB=true

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO

# =========================================================================
#  Trading / broker
#  DEFAULTS ARE SAFE: paper broker + dry-run. No real money moves until you
#  set BROKER=robinhood AND LIVE_TRADING=true.
# =========================================================================

# Which broker executes trades: paper (simulated, default) | robinhood (real, equities)
BROKER=paper

# false = DRY-RUN (intended orders are logged, never sent). Set true for real orders.
LIVE_TRADING=false

# Master kill switch. false = no orders at all. Toggle at runtime with /kill /resume.
TRADING_ENABLED=true

# Auto-trade on the engine's signals each cycle (vs. manual /order only).
AUTO_TRADE=true

# Bypass the US-market-hours guard (holidays are NOT tracked either way).
IGNORE_MARKET_HOURS=false

# --- Order sizing / risk limits (USD) ---
BASE_ORDER_NOTIONAL=100       # base $ per order (scaled up to 1.0x by confidence)
MAX_ORDER_NOTIONAL=500        # hard cap per single order
MAX_POSITION_NOTIONAL=2000    # hard cap on total exposure per symbol
MAX_OPEN_POSITIONS=10         # max distinct symbols held
DAILY_LOSS_LIMIT=0            # halt if session equity drops this much (0 = off)
ORDER_CONFIDENCE_MIN=0.15     # ignore signals weaker than this
PAPER_STARTING_CASH=10000     # starting cash for the paper broker

# --- Robinhood credentials (ONLY needed when BROKER=robinhood; never hardcode) ---
# WARNING: robin_stocks is unofficial and against Robinhood's ToS — use at your own risk.
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
# TOTP shared secret for app-based 2FA (required for headless login on Railway).
# In Robinhood: enable Two-Factor -> Authenticator App, then copy the setup/secret key.
ROBINHOOD_MFA_SECRET=
